extend ../../../layouts/application

append variables
  - locals.currentPage = "datasets/jogo";
  - locals.language = "en";
  - locals.title = "Datasets > JoGo | TogoVar";

block head
  each css in htmlWebpackPlugin.files.css
    link(href=css, rel="stylesheet")

block content
