extend ../../layouts/application

append variables
  - locals.currentPage = "terms";
  - locals.language = "en";
  - locals.title = "Terms | TogoVar";

block head
  each css in htmlWebpackPlugin.files.css
    link(href=css, rel="stylesheet")

block content
  main
    article.common-document
      header.header
        h2.title Terms of Use
      .contents
        section.section
          h3#third-party-data.sectiontitle Terms for third-party data
          p.body Third-party data is subject to the terms specified by each provider. Review the applicable terms, attribution requirements, and citation instructions in the table below; for data not listed, follow the information provided by its source.
            |  TogoVar does not grant permission for rights held by third parties.
            |  When publishing research that uses TogoVar, please cite the TogoVar article. This request does not replace any terms or citation requirements specified by each provider.
          blockquote.attribution-template
            | Mitsuhashi N, Toyo-Oka L, Katayama T, Kawashima M, Kawashima S, Miyazaki K, Takagi T. TogoVar: A comprehensive Japanese genetic variation database. Hum Genome Var. 2022;9:44. DOI:
            |
            a.hyper-text.-external(target='_blank', href='https://doi.org/10.1038/s41439-022-00222-9') https://doi.org/10.1038/s41439-022-00222-9
            | . PMID:
            |
            a.hyper-text.-external(target='_blank', href='https://pubmed.ncbi.nlm.nih.gov/36509753/') 36509753
            | .
          table.table._column-span-all
            thead
              tr
                th Data
                th Terms or provider information
            tbody
              tr
                td AlphaMissense
                td
                  a.hyper-text.-external(target='_blank', href='https://github.com/google-deepmind/alphamissense#license-and-disclaimer') AlphaMissense predictions by DeepMind Technologies Limited
                  |  (
                  a.hyper-text.-external(target='_blank', href='https://creativecommons.org/licenses/by/4.0/') CC BY 4.0
                  | )
                  br
                  | Citation:
                  |
                  a.hyper-text.-external(target='_blank', href='https://doi.org/10.1126/science.adg7492') Cheng et al. (2023)
              if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                tr
                  td BBJ1K
                  td
                    a(href='/doc/datasets/bbj1k') TogoVar dataset description
                tr
                  td BBJ2K
                  td
                    a(href='/doc/datasets/bbj2k') TogoVar dataset description
              tr
                td CADD
                td
                  a.hyper-text.-external(target='_blank', href='https://cadd.bihealth.org/impressum') CADD License
              tr
                td ClinVar
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/clinvar/docs/maintenance_use/') Maintenance and use of ClinVar data
              tr
                td Colil
                td
                  a.hyper-text.-external(target='_blank', href='https://colil.dbcls.jp/portal/') Colil
              tr
                td Ensembl / Variant Effect Predictor (VEP)
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ensembl.org/info/about/legal/disclaimer.html') Ensembl Disclaimer
              tr
                td GEM-J WGA
                td
                  a(href='/doc/datasets/gem_j_wga#terms') TogoVar dataset description
              tr
                td gnomAD
                td
                  a.hyper-text.-external(target='_blank', href='https://gnomad.broadinstitute.org/terms') gnomAD Terms and Data Information
              tr
                td Genome Reference Consortium (#{ TOGOVAR_FRONTEND_REFERENCE })
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/grc/human/data?asm=' + TOGOVAR_FRONTEND_REFERENCE) Human Genome Assembly #{ TOGOVAR_FRONTEND_REFERENCE }
              tr
                td GWAS Catalog
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ebi.ac.uk/gwas/docs/about') About the GWAS Catalog
              tr
                td HGNC
                td
                  a.hyper-text.-external(target='_blank', href='https://www.genenames.org/about/license/') HGNC License
              tr
                td HGVD
                td
                  a.hyper-text.-external(target='_blank', href='https://www.hgvd.genome.med.kyoto-u.ac.jp/about.html') About HGVD
              tr
                td JGA-SNP
                td
                  a(href='/doc/datasets/jga_snp') TogoVar dataset description
              tr
                td JGA-WES
                td
                  a(href='/doc/datasets/jga_wes') TogoVar dataset description
              if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                tr
                  td JGA-WGS
                  td
                    a(href='/doc/datasets/jga_wgs') TogoVar dataset description
                tr
                  td JoGo
                  td
                    a.hyper-text.-external(target='_blank', href='https://jogo.csml.org/license') JoGo License
              tr
                td LitVar, MedGen, and PubMed
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/home/about/policies/') NCBI Website and Data Usage Policies and Disclaimers
              tr
                td MGeND
                td
                  a.hyper-text.-external(target='_blank', href='https://mgend.jihs.go.jp/about#data-link') About MGeND data use
              if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                tr
                  td NCBN
                  td
                    a(href='/doc/datasets/ncbn#terms') TogoVar dataset description
              tr
                td PubTator3
                td
                  a.hyper-text.-external(target='_blank', href='https://ftp.ncbi.nlm.nih.gov/pub/lu/PubTator3/') PubTator3
              tr
                td SSCV DB
                td
                  a.hyper-text.-external(target='_blank', href='https://sscvdb.io/') SSCV DB
              tr
                if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                  td ToMMo #{ GLOBALS.TOMMO_VERSION }KJPN and ToMMo JSV1
                else
                  td ToMMo #{ GLOBALS.TOMMO_VERSION }KJPN
                td
                  a.hyper-text.-external(target='_blank', href='https://jmorp.megabank.tohoku.ac.jp/help/conditions-of-use') jMorp Conditions of Use

        section.section
          h3#togovar-license.sectiontitle Terms for TogoVar-original materials
          p.body
            | Explanatory text, metadata, and the selection, arrangement, and structure of the database on this website for which DBCLS holds the rights (collectively, “TogoVar-original materials”) are made available under
            |
            a.hyper-text.-external(target='_blank', href='https://creativecommons.org/publicdomain/zero/1.0/') CC0 1.0 Universal
            | . This does not apply to materials for which third parties hold rights.

        section.section
          h3#site-policy.sectiontitle Site Policy
          p.body
            | This website is operated and managed by the Database Division for Life Science (DBCLS), BioData Science Initiative (BSI), National Institute of Genetics (NIG), Research Organization of Information and Systems (ROIS). The site policy for this website conforms to the
            |
            a.hyper-text.-external(target='_blank', href='https://dbcls.rois.ac.jp/policy-en.html') DBCLS Site Policy
            | . If the DBCLS Site Policy and the terms stated on this page differ, the terms stated on this page take precedence.
