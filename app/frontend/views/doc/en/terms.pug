extend ../../layouts/application

append variables
  - locals.currentPage = "terms";
  - locals.language = "en";
  - locals.title = "Terms | TogoVar";

block head
  each css in htmlWebpackPlugin.files.css
    link(href=css, rel="stylesheet")

block content
  main
    article.common-document
      header.header
        h2.title Terms of Use
      .contents
        section.section
          h3.sectiontitle Summary
          p.body Anyone may browse and search TogoVar. Before using information obtained from TogoVar, determine which of the following categories it belongs to.
          ul.unordered-list
            li
              strong TogoVar-original materials:
              |  Explanatory text, metadata, and the selection, arrangement, and structure of the database created by TogoVar and for which TogoVar holds the rights are licensed under the
              |
              a.hyper-text.-external(target='_blank', href='https://creativecommons.org/licenses/by/4.0/') Creative Commons Attribution 4.0 International License (CC BY 4.0)
              | .
            li
              strong Third-party data:
              |  Data incorporated into TogoVar from other providers remains subject to the terms specified by each provider.
          p.body CC BY 4.0 applies only to the extent that TogoVar holds the relevant rights. If the terms for third-party data differ, follow the terms specified by the provider of that data.

        section.section
          h3#togovar-license.sectiontitle License for TogoVar-original materials
          p.body
            | Explanatory text, metadata, and the selection, arrangement, and structure of the database created by TogoVar and for which TogoVar holds the rights may be used under
            |
            a.hyper-text.-external(target='_blank', href='https://creativecommons.org/licenses/by/4.0/') CC BY 4.0
            | .
          h4.heading Why the license changed from ODbL 1.0 to CC BY 4.0
          p.body
            | TogoVar-original materials were previously provided under ODbL 1.0. Beginning with release 2026.1, they are provided under CC BY 4.0.
          p.body
            | CC BY 4.0 permits sharing and adaptation provided that appropriate credit is given, a link to the license is provided, and changes are indicated. By contrast, the
            |
            a.hyper-text.-external(target='_blank', href='https://opendatacommons.org/licenses/odbl/summary/') Open Data Commons Open Database License (ODbL) 1.0
            |  includes a Share-Alike requirement: if an adapted database is publicly used, that adapted database must also be offered under the ODbL. TogoVar uses CC BY 4.0 rather than the ODbL for TogoVar-original materials to make them easier to incorporate into research outputs, documentation, and other databases, while clearly distinguishing them from third-party data that remains subject to each provider's terms.
          p.body Under CC BY 4.0, you may do the following for commercial and non-commercial purposes:
          ul.unordered-list
            li
              strong Share:
              |  Copy and redistribute the materials.
            li
              strong Adapt:
              |  Modify the materials and incorporate them into other works or databases.
          p.body When using these materials, you must comply with the following conditions:
          ul.unordered-list
            li
              strong Attribution:
              |  Cite the TogoVar article below and provide a link to CC BY 4.0.
            li
              strong Indication of changes:
              |  Indicate whether you modified the materials.
          h4.heading Citing and crediting TogoVar
          p.body The following attribution can be copied and used as written.
          blockquote.attribution-template
            | This work used TogoVar (Database Division for Life Science (DBCLS), BioData Science Initiative (BSI), National Institute of Genetics (NIG), Research Organization of Information and Systems (ROIS),
            |
            a.hyper-text.-external(target='_blank', href='https://togovar.org/') https://togovar.org/
            | ). TogoVar-original materials are licensed under
            |
            a.hyper-text.-external(target='_blank', href='https://creativecommons.org/licenses/by/4.0/') CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/)
            | .
            br
            | Citation: Mitsuhashi N, Toyo-Oka L, Katayama T, Kawashima M, Kawashima S, Miyazaki K, Takagi T. TogoVar: A comprehensive Japanese genetic variation database. Hum Genome Var. 2022;9:44. DOI:
            |
            a.hyper-text.-external(target='_blank', href='https://doi.org/10.1038/s41439-022-00222-9') https://doi.org/10.1038/s41439-022-00222-9
            | . PMID:
            |
            a.hyper-text.-external(target='_blank', href='https://pubmed.ncbi.nlm.nih.gov/36509753/') 36509753
            | .
          p.body.attribution-note If you modified the materials, add a statement such as “The TogoVar materials were modified.”
          p.body This license does not apply to third-party data, third-party trademarks or logos, or any other material for which TogoVar does not hold the rights.

        section.section
          h3#third-party-data.sectiontitle Terms for third-party data
          p.body TogoVar integrates data obtained from multiple providers. Before using such data, follow the table below to review the applicable terms, attribution requirements, and citation instructions. TogoVar does not grant permission for rights held by third parties.
          table.table._column-span-all
            thead
              tr
                th Data
                th Terms or provider information
            tbody
              tr
                td AlphaMissense
                td
                  a.hyper-text.-external(target='_blank', href='https://github.com/google-deepmind/alphamissense#license-and-disclaimer') AlphaMissense predictions by DeepMind Technologies Limited
                  |  (
                  a.hyper-text.-external(target='_blank', href='https://creativecommons.org/licenses/by/4.0/') CC BY 4.0
                  | )
                  br
                  | Citation:
                  |
                  a.hyper-text.-external(target='_blank', href='https://doi.org/10.1126/science.adg7492') Cheng et al. (2023)
              if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                tr
                  td BBJ1K
                  td
                    a(href='/doc/datasets/bbj1k') TogoVar dataset description
                tr
                  td BBJ2K
                  td
                    a(href='/doc/datasets/bbj2k') TogoVar dataset description
              tr
                td CADD
                td
                  a.hyper-text.-external(target='_blank', href='https://cadd.bihealth.org/impressum') CADD License
              tr
                td ClinVar
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/clinvar/docs/maintenance_use/') Maintenance and use of ClinVar data
              tr
                td Colil
                td
                  a.hyper-text.-external(target='_blank', href='https://colil.dbcls.jp/portal/') Colil
              tr
                td Ensembl / Variant Effect Predictor (VEP)
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ensembl.org/info/about/legal/disclaimer.html') Ensembl Disclaimer
              tr
                td GEM-J WGA
                td
                  a(href='/doc/datasets/gem_j_wga#terms') TogoVar dataset description
              tr
                td gnomAD
                td
                  a.hyper-text.-external(target='_blank', href='https://gnomad.broadinstitute.org/terms') gnomAD Terms and Data Information
              tr
                td Genome Reference Consortium (#{ TOGOVAR_FRONTEND_REFERENCE })
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/grc/human/data?asm=' + TOGOVAR_FRONTEND_REFERENCE) Human Genome Assembly #{ TOGOVAR_FRONTEND_REFERENCE }
              tr
                td GWAS Catalog
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ebi.ac.uk/gwas/docs/about') About the GWAS Catalog
              tr
                td HGNC
                td
                  a.hyper-text.-external(target='_blank', href='https://www.genenames.org/about/license/') HGNC License
              tr
                td HGVD
                td
                  a.hyper-text.-external(target='_blank', href='https://www.hgvd.genome.med.kyoto-u.ac.jp/about.html') About HGVD
              tr
                td JGA-SNP
                td
                  a(href='/doc/datasets/jga_snp') TogoVar dataset description
              tr
                td JGA-WES
                td
                  a(href='/doc/datasets/jga_wes') TogoVar dataset description
              if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                tr
                  td JGA-WGS
                  td
                    a(href='/doc/datasets/jga_wgs') TogoVar dataset description
                tr
                  td JoGo
                  td
                    a.hyper-text.-external(target='_blank', href='https://jogo.csml.org/license') JoGo License
              tr
                td LitVar, MedGen, and PubMed
                td
                  a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/home/about/policies/') NCBI Website and Data Usage Policies and Disclaimers
              tr
                td MGeND
                td
                  a.hyper-text.-external(target='_blank', href='https://mgend.jihs.go.jp/about#data-link') About MGeND data use
              if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                tr
                  td NCBN
                  td
                    a(href='/doc/datasets/ncbn#terms') TogoVar dataset description
              tr
                td PubTator3
                td
                  a.hyper-text.-external(target='_blank', href='https://ftp.ncbi.nlm.nih.gov/pub/lu/PubTator3/') PubTator3
              tr
                td SSCV DB
                td
                  a.hyper-text.-external(target='_blank', href='https://sscvdb.io/') SSCV DB
              tr
                if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                  td ToMMo #{ GLOBALS.TOMMO_VERSION }KJPN and ToMMo JSV1
                else
                  td ToMMo #{ GLOBALS.TOMMO_VERSION }KJPN
                td
                  a.hyper-text.-external(target='_blank', href='https://jmorp.megabank.tohoku.ac.jp/help/conditions-of-use') jMorp Conditions of Use
