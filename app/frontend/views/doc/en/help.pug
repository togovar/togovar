    link(href=css, rel="stylesheet")
  each js in htmlWebpackPlugin.files.js.filter(x => x.match(/^\/js\/main-/))
    script(type="text/javascript", src=js)

block content
  main
    article.common-document
      header.header
        h2.title Help
      .contents
        section.section
          ul.page-index
            li.category
              h3.categorytitle TogoVar in general
              ul.categorylist
                li.item.-question
                  a.link(href='#g1') What are the objectives and utilities of TogoVar?
                li.item.-question
                  a.link(href='#g2') Do you have videos that explain TogoVar?
            li.category
              h3.categorytitle About the terms of use
              ul.categorylist
                li.item.-question
                  a.link(href='#t1') Can I use TogoVar for free?
                li.item.-question
                  a.link(href='#t2') How should I cite TogoVar in my publication?
                li.item.-question
                  a.link(href='#t3') Can I use it for commercial purposes?
            li.category
              h3.categorytitle About the data collected in TogoVar
              ul.categorylist
                li.item.-question
                  a.link(href='#d1') Can I retrieve phenotype information on an individual level?
                li.item.-question
                  a.link(href='#d2') Are the data linked with information about gene expression and proteins?
                li.item.-question
                  a.link(href='#d3') What software is used to detect variants, and how is data quality managed?
                li.item.-question
                  a.link(href='#d4') What are the targeted variant types for TogoVar?
                li.item.-question
                  a.link(href='#d5') Where does TogoVar obtain consequence annotations?
                li.item.-question
                  a.link(href='#d6') Where does TogoVar obtain clinical significance annotations?
                li.item.-question
                  a.link(href='#d7') What are CADD, AlphaMissense, SIFT and PolyPhen?
                li.item.-question
                  a.link(href='#d8') Was a liftover tool used for generating variant data?
                li.item.-question
                  a.link(href='#d9') Why do allele frequencies differ between datasets even within the same Japanese ancestry group?
                li.item.-question
                  a.link(href='#d10') What is SSCV DB?
            li.category
              h3.categorytitle About the TogoVar search system
              ul.categorylist
                li.item.-question
                  a.link(href='#s1')
                    | What does the frequency indicator in the Frequency column of the search
                    | results represent?
                li.item.-question
                  a.link(href='#s8') What is the difference between alternate allele frequency and genotype counts?
                li.item.-question
                  a.link(href='#s2')
                    | For each variant type, how is the position, reference and alternate allele
                    | described respectively?
                li.item.-question
                  a.link(href='#s3') How are variants represented in TogoVar?
                li.item.-question
                  a.link(href='#s4') Can I search by HGVS description (e.g. ALDH2:p.Glu504Lys)?
                li.item.-question
                  a.link(href='#s5') What can I do with the Advanced search?
                li.item.-question
                  a.link(href='#s6') Can I search for variants with higher alternate allele frequencies in Japanese populations than in other populations?
                li.item.-question
                  a.link(href='#s7') Can I search for variants by both positions on GRCh38 and GRCh37?

      .contents
        section.section
          h3.sectiontitle TogoVar in general
          #g1.question-answer
            h4.question What are the objectives and utilities of TogoVar?
            .answer
              p
                | NGS technologies have enabled large-scale genome sequencing to capture variants at low frequencies.
                | However,
                | existing databases do not contain sufficient variant frequency data for Japanese populations.
                | To address this problem, TogoVar seeks to provide a reliable frequency information by assembling variant
                | information from the NBDC Human Database/Japanese Genotype-phenotype Archive (JGA) and public Japanese
                | genomic
                | variation data.
              p
                | In addition, since the reference human genome sequence can be updated, the genomic position may vary for
                | the
                | same variant if it refers to a different genome build. Thus, in our database, a unique ID is
                | assigned to the same variant, thereby preventing the need to convert the positional information of the
                | variant
                | among different reference sequences, as done by researchers.
          #g2.question-answer
            h4.question Do you have videos that explain TogoVar?
            .answer
              p
                | See
                |
                a(href='https://togotv.dbcls.jp/en/') TogoTV
                | . Videos on TogoVar are available at
                |
                a(href='https://togotv.dbcls.jp/en/result.html?type=manual&lang=en&page=1&query=TogoVar') TogoVar videos on TogoTV
                | .

        section.section
          h3.sectiontitle About the terms of use
          #t1.question-answer
            h4.question Can I use TogoVar for free?
            .answer
              p
                | You can use TogoVar for free. For the use of the database, refer to the
                |
                a(href='/doc/terms') Terms
                | .
          #t2.question-answer
            h4.question How should I cite TogoVar in my publication?
            .answer
              p
                | Refer to the attribution (credit) display examples in
                |
                a(href='/doc/terms') Terms
                | .
          #t3.question-answer
            h4.question Can I use it for commercial purposes?
            .answer
              p
                | The TogoVar website and TogoVar-original materials may be used commercially under the terms of CC BY 4.0.
                | For third-party data incorporated into TogoVar, follow the terms specified by each provider.
                | For more details, refer to
                |
                a(href='/doc/terms') Terms
                | .

        section.section
          h3.sectiontitle About the data collected in TogoVar
          #d1.question-answer
            h4.question Can I retrieve phenotype information on an individual level?
            .answer
              p
                | TogoVar database does not keep private information, and we do not currently provide phenotype information
                | for each individual. For more details about phenotype information, please directly contact the research
                | groups
                | described in the
                |
                if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                  a(href='./datasets/jga_wgs') JGA-WGS dataset
                  | , 
                a(href='./datasets/jga_wes') JGA-WES dataset
                |
                | , and
                |
                a(href='/doc/datasets/jga_snp') JGA-SNP dataset
                | .
          #d2.question-answer
            h4.question Are the data linked with information about gene expression and proteins?
            .answer
              p
                | TogoVar integrates publicly available information on human genomic variants, primarily for the Japanese population.
                | We also provide protein-centered views, including mapping variant positions onto 3D structures from
                a.hyper-text.-external(target='_blank', href='https://pdbj.org/?lang=en') PDBj
                | /
                a.hyper-text.-external(target='_blank', href='https://alphafold.ebi.ac.uk/') AlphaFold
                | (e.g.
                a.hyper-text.-external(target='_blank', href='https://grch38.togovar.org/gene/1097#protein-structure') BRAF gene
                | ) and a Protein Browser that aligns variants with key annotations along the amino acid sequence, such as phosphorylation sites (
                a.hyper-text.-external(target='_blank', href='https://jpostdb.org/') jPOST
                | ), glycosylation sites (
                a.hyper-text.-external(target='_blank', href='https://glycosmos.org/') GlyCosmos
                | ), and disease-associated variants (
                a.hyper-text.-external(target='_blank', href='https://www.uniprot.org/') UniProt
                | ) (e.g.
                a.hyper-text.-external(target='_blank', href='https://grch38.togovar.org/gene/1101#protein-browser') BRCA2 gene
                | ).
                | Because TogoVar is built on RDF, it can be readily extended to link with gene expression and other RDF-based resources, and we plan to expand these links step by step.
          #d3.question-answer
            h4.question What software is used to detect variants, and how is data quality managed?
            .answer
              p
                | The software and quality-control methods differ by dataset. See “Data processing method” for each dataset from the
                a(href='/doc/datasets') TogoVar datasets page
                | . Details for JGA-WES are provided on the
                a(href='/doc/datasets/analysis') JGA-WES data processing method page
                | .
          #d4.question-answer
            h4.question What are the targeted variant types for TogoVar?
            .answer
              p
                | There are five targeted variant types for TogoVar: SNV, Insertion, Deletion, Indel, and Substitution. Of
                |
                a.hyper-text.-external(target='_blank', href='https://hgvs-nomenclature.org/stable/background/simple/')
                  | 5 types that HGVS enumerated as the types of variants
                | , Duplication is classified as Insertion, and Indels, for which the lengths of Insertion and Deletion
                | are the same, are classified as Substitution. To identify the type of the variant,
                |
                a.hyper-text.-external(target='_blank', href='https://www.ensembl.org/vep')
                  | Variant Effect Predictor (VEP)
                |  is used.
          #d5.question-answer
            h4.question Where does TogoVar obtain consequence annotations?
            .answer
              p
                | The value of variant consequence in
                |
                a.hyper-text.-external(target='_blank', href='https://asia.ensembl.org/info/genome/variation/prediction/predicted_data.html#consequences')
                  | Variant Effect Predictor (VEP)
                |  is displayed. If there are multiple transcripts for a single variant, only the most critical
                | consequence may be displayed.
          #d6.question-answer
            h4.question Where does TogoVar obtain clinical significance annotations?
            .answer
              p
                | The value of
                |
                a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/clinvar/docs/clinsig/#clinsig_options_scv')
                  | clinical significance in ClinVar
                |
                | and
                |
                a.hyper-text.-external(target='_blank', href='https://mgend.jihs.go.jp/about#interpretation-link')
                  | clinical significance in MGeND
                |
                | are displayed.
          #d7.question-answer
            h4.question What are CADD, AlphaMissense, SIFT, and PolyPhen?
            .answer
              p
                | The following scores are used to predict the potential impact of variants and were annotated using
                |
                a.hyper-text.-external(target='_blank', href='https://asia.ensembl.org/info/genome/variation/prediction/protein_function.html')
                  | Variant Effect Predictor (VEP)
                | . CADD scores the deleteriousness of a wide range of variants, while AlphaMissense, SIFT, and PolyPhen
                | specifically predict the impact of amino acid substitutions on protein function.
                | The icons below indicate the score thresholds used for qualitative predictions.
              ul.unordered-list._margin-bottom._align-left
                li
                  strong CADD (PHRED score)
                  br
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='D') &ge; 20
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='POSSD') &ge; 10
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='T') &lt; 10
                  span
                    | CADD (Combined Annotation Dependent Depletion) integrates diverse genomic annotations to score
                    | the deleteriousness of a wide range of variants. Unlike the other tools listed here, CADD is not limited
                    | to missense variants. PHRED-scaled scores &ge; 10 and &ge; 20 correspond approximately to the top 10%
                    | and top 1% of variants ranked by predicted deleteriousness across the genome, respectively. See
                    |
                  a.hyper-text.-external(target='_blank', href='https://cadd.bihealth.org/') CADD
                  |
                  | for details.
                li
                  strong AlphaMissense
                  br
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='LP') &gt; 0.564
                    span._margin-left Likely pathogenic
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='A') &ge; 0.340
                    span._margin-left Ambiguous
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='LB') &lt; 0.340
                    span._margin-left Likely benign
                  span The score thresholds for "Likely pathogenic" and "Likely benign" were chosen to classify pathogenic and benign ClinVar variants with 90% precision, respectively. See
                    |
                    |
                  a.hyper-text.-external(target='_blank', href='https://asia.ensembl.org/info/docs/tools/vep/script/vep_plugins.html#alphamissense') AlphaMissense in VEP Plugins
                  |
                  | for details.
                li
                  strong SIFT
                  br
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='D') &lt; 0.05
                    span._margin-left Deleterious
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='T') &ge; 0.05
                    span._margin-left Tolerated
                  span The score represents the normalized probability of an amino acid change being tolerated. Scores closer to zero indicate a higher likelihood of the change being deleterious.
                    |
                    | The qualitative prediction is based on this score. Substitutions with a score less than 0.05 are classified as "Deleterious", while all others are considered "Tolerated". See
                    |
                  a.hyper-text.-external(target='_blank', href='https://asia.ensembl.org/info/genome/variation/prediction/protein_function.html#sift') SIFT in Pathogenicity prediction of Ensembl Variation
                  |
                  | for details.
                li
                  strong PolyPhen
                  br
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='PROBD') &gt; 0.908
                    span._margin-left Probably Damaging
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='POSSD') &gt; 0.446
                    span._margin-left Possibly Damaging
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='B') &le; 0.446
                    span._margin-left Benign
                  div
                    .variant-effect-prediction-badge._width_5em._align-center(data-function='U') Unknown
                    span._margin-left Unknown
                  span Variants are predicted as "Probably Damaging" if they have posterior probability scores indicating an estimated false positive rate (FPR) of 5% or below.
                    |
                    | Those with FPRs at or below 10% are "Possibly Damaging", while variants with FPRs above 10% are classified as "Benign". See
                    |
                  a.hyper-text.-external(target='_blank', href='https://asia.ensembl.org/info/genome/variation/prediction/protein_function.html#polyphen') Polyphen in Pathogenicity prediction of Ensembl Variation
                  |
                  | for details.
          #d8.question-answer
            h4.question Was a liftover tool used for generating variant data?
            .answer
              p
                | Yes. Some of the GRCh38 datasets have been created by lifting over their GRCh37 datasets.
                | Please refer to
                a.hyper-text.-external(target='_blank', href='https://grch38.togovar.org/doc/datasets')
                  |
                  | the Liftover GRCh37 column in the TogoVar datasets (GRCh38) page
                | for the target datasets. A liftover tool
                |
                a.hyper-text.-external(target='_blank', href='https://github.com/informationsea/transanno')
                  | transanno
                | has been used since the release on November 16, 2023.
                |
                a.hyper-text.-external(target='_blank', href='https://crossmap.sourceforge.net/')
                  | CrossMap
                | was used until the release on July 14, 2023.
          #d9.question-answer
            h4.question Why do allele frequencies differ between datasets even within the same Japanese ancestry group?
            .answer
              p
                | Even within the same Japanese ancestry group, allele frequencies may differ between datasets when participants’ regions of origin or sampling designs differ. Fine-scale genetic structure related to geographic regions has been reported within the Japanese population, and differences in regional composition or participant selection may therefore be reflected as differences in allele frequencies between datasets. Other factors, such as sample size, age distribution, disease status, sequencing conditions, variant calling, quality control, and allele frequency calculation methods, can also contribute to such differences.
              p
                | Reference:
                br
                | Sakaue S. et al. Dimensionality reduction reveals fine-scale structure in the Japanese population with consequences for polygenic risk prediction. Nature Communications, 2020.
          #d10.question-answer
            h4.question What is SSCV DB?
            .answer
              p
                | #[a.hyper-text.-external(target='_blank', href='https://sscvdb.io/') SSCV DB] is a database of splice-site creating variants (SSCVs) identified from publicly available transcriptome sequencing data. SSCVs are variants that may create new splice sites and potentially cause aberrant splicing. In TogoVar, the predicted splicing type registered in SSCV DB is shown with a link to the corresponding SSCV DB record.
              p
                | Reference:
                br
                | Iida N, Okada A, Kobayashi Y, Chiba K, Yatabe Y, Shiraishi Y. Systematically developing a registry of splice-site creating variants utilizing massive publicly available transcriptome sequence data. Nat Commun. 2025;16:426. DOI: #[a.hyper-text.-external(target='_blank', href='https://doi.org/10.1038/s41467-024-55185-y') 10.1038/s41467-024-55185-y]. PMID: #[a.hyper-text.-external(target='_blank', href='https://pubmed.ncbi.nlm.nih.gov/39788962/') 39788962].

        section.section
          h3.sectiontitle About the TogoVar search system
          #s1.question-answer._column-span-all
            h4.question
              | What does the frequency indicator shown in the Alt frequency column of the search results represent?
            .answer
              p
                | The frequency indicator shows the alternate (Alt) allele count (AC) or frequency (AF) for each dataset 
                | on a nine-level scale. Datasets in which at least one Alt homozygote or hemizygote has been identified are marked 
                | with an icon in the upper-right corner of the indicator. 
                | The color of each indicator corresponds to the color assigned to the dataset.
              ._flex._break-avoid
                ._padding-right-large
                  frequency-block-view(data-dataset="" data-frequency="na")
                  | &nbsp; Not available
                  br
                  frequency-block-view(data-dataset="" data-frequency="monomorphic")
                  | &nbsp; AC = 0 (Monomorphic)
                  br
                  frequency-block-view(data-dataset="" data-frequency="undefined" data-allele-count="1")
                  | &nbsp; AC = 1 (Singleton)
                  br
                  frequency-block-view(data-dataset="" data-frequency="<0.0001")
                  | &nbsp; AF &lt; 0.0001
                  br
                  frequency-block-view(data-dataset="" data-frequency="<0.001")
                  | &nbsp; AF &lt; 0.001
                  br
                  frequency-block-view(data-dataset="" data-frequency="<0.01")
                  | &nbsp; AF &lt; 0.01
                  br
                  frequency-block-view(data-dataset="" data-frequency="<0.05")
                  | &nbsp; AF &lt; 0.05
                  br
                  frequency-block-view(data-dataset="" data-frequency="<0.5")
                  | &nbsp; AF &lt; 0.5
                  br
                  frequency-block-view(data-dataset="" data-frequency="≥0.5")
                  | &nbsp; AF &ge; 0.5
                ._padding-right-large
                  frequency-block-view(data-dataset="" data-homozygous-allele-count)
                  | &nbsp; &ge;1 Alt homozygote
                  br
                  frequency-block-view(data-dataset="" data-hemizygote-allele-count)
                  | &nbsp; &ge;1 Alt hemizygote
                ._padding-right-large
                  frequency-block-view(data-dataset="gem_j_wga" data-frequency="≥0.5")
                  | &nbsp; GEM-J WGA
                  br
                  if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                    frequency-block-view(data-dataset="jga_wgs" data-frequency="≥0.5")
                    | &nbsp; JGA-WGS
                    br
                  frequency-block-view(data-dataset="jga_wes" data-frequency="≥0.5")
                  | &nbsp; JGA-WES
                  br
                  frequency-block-view(data-dataset="jga_snp" data-frequency="≥0.5")
                  | &nbsp; JGA-SNP
                  br
                  frequency-block-view(data-dataset="tommo" data-frequency="≥0.5")
                  if TOGOVAR_FRONTEND_REFERENCE === "GRCh37"
                    | &nbsp; ToMMo 8.3KJPN
                  else if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                    | &nbsp; ToMMo 61KJPN
                  br
                  if TOGOVAR_FRONTEND_REFERENCE === "GRCh38"
                    frequency-block-view(data-dataset="tommo_jsv1" data-frequency="≥0.5")
                    | &nbsp; ToMMo JSV1
                    br
                    frequency-block-view(data-dataset="ncbn" data-frequency="≥0.5")
                    | &nbsp; NCBN
                    br
                    frequency-block-view(data-dataset="bbj1k" data-frequency="≥0.5")
                    | &nbsp; BBJ1K
                    br
                    frequency-block-view(data-dataset="bbj2k" data-frequency="≥0.5")
                    | &nbsp; BBJ2K
                    br
                    frequency-block-view(data-dataset="jogo" data-frequency="≥0.5")
                    | &nbsp; JoGo
                    br
                  if TOGOVAR_FRONTEND_REFERENCE === "GRCh37"
                    frequency-block-view(data-dataset="hgvd" data-frequency="≥0.5")
                    | &nbsp; HGVD
                    br
                  frequency-block-view(data-dataset="gnomad_genomes" data-frequency="≥0.5")
                  | &nbsp; gnomAD genomes
                  br
                  frequency-block-view(data-dataset="gnomad_exomes" data-frequency="≥0.5")
                  | &nbsp; gnomAD exomes

          #s8.question-answer._column-span-all
            h4.question What is the difference between alternate allele frequency and genotype counts?
            .answer
              p
                | In the #[a.hyper-text.-external(target='_blank', href='https://samtools.github.io/hts-specs/VCFv4.2.pdf') VCF specification], AC (allele count) is the number of copies of each ALT allele in called genotypes, AF (allele frequency) is its frequency, and AN is the total number of called alleles. Genotype counts are the numbers of individuals with each genotype, such as Ref/Ref, Ref/Alt, or Alt/Alt. In other words, AF and AC are measured at the allele level, whereas genotype counts are measured at the individual level.
              p
                | For introductory explanations, see the #[a.hyper-text.-external(target='_blank', href='https://www.genome.gov/genetics-glossary/Allele') NHGRI definition of allele] and the #[a.hyper-text.-external(target='_blank', href='https://www.genome.gov/genetics-glossary/genotype') NHGRI definition of genotype].

          #s2.question-answer._column-span-all
            h4.question
              | For each variant type, how is the position, reference and alternate allele described respectively?
            .answer
              p
                | Examples in the VCF representation used by TogoVar are shown below. Note that the position of the first base in the
                | chromosome is 1.
              table.results-view
                thead
                  tr
                    th
                      p Variant Type
                    th
                      p ID
                    th
                      p Position
                    th
                      p Ref / Alt
                    th
                      p Description
                tbody
                  tr
                    td
                      .variant-type SNV
                    td
                      a(target='_blank', href='/variant/tgv167913215') tgv167913215
                    td
                      .chromosome-position
                        .chromosome 12
                        .coordinate 111767141
                    td
                      .ref-alt
                        span.ref C
                        span.arrow
                        span.alt A
                    td The 111767141st base C in chromosome 12 was replaced by A.
                  tr
                    td
                      .variant-type Ins
                    td
                      a(target='_blank', href='/variant/tgv134135934') tgv134135934
                    td
                      .chromosome-position
                        .chromosome 12
                        .coordinate 111786238
                    td
                      .ref-alt
                        span.ref T
                        span.arrow
                        span.alt TG
                    td A base G was inserted between the 111786238th and 111786239th bases in chromosome 12.
                  tr
                    td
                      .variant-type Del
                    td
                      a(target='_blank', href='/variant/tgv110307325') tgv110307325
                    td
                      .chromosome-position
                        .chromosome 12
                        .coordinate 111778835
                    td
                      .ref-alt
                        span.ref GA
                        span.arrow
                        span.alt G
                    td The 111778836th base A in chromosome 12 was deleted.
          #s3.question-answer._column-span-all
            h4.question How are variants represented in TogoVar?
            .answer
              p
                | TogoVar uses #[a.hyper-text.-external(target='_blank', href='https://samtools.github.io/hts-specs/VCFv4.2.pdf') VCF] notation: a variant is uniquely identified by its human genome build, chromosome, genomic position (POS), reference allele (REF), and alternate allele (ALT). Insertions and deletions also follow the VCF representation rules. Examples of variant notations in TogoVar / VCF, dbSNP, and #[a.hyper-text.-external(target='_blank', href='https://varnomen.hgvs.org/') HGVS] are shown below.
              table.results-view
                thead
                  tr.groupingrow
                    th(colspan='2')
                    th
                      p TogoVar
                    th(colspan='3')
                      p TogoVar / VCF
                    th(colspan='4')
                      p dbSNP
                    th
                      p HGVS
                  tr
                    th
                    th.separator
                    th
                      p ID
                    th
                      p Position (GRCh38)
                    th
                      p Ref / Alt
                    th.separator
                    th
                      p ID
                    th
                      p Position (GRCh38)
                    th
                      p Alleles
                    th.separator
                    th
                tbody
                  tr
                    td(rowspan='2')
                      .variant-type SNV
                    td.separator(rowspan='2')
                    td
                      a(target='_blank', href='/variant/tgv167913215') tgv167913215
                    td(rowspan='2')
                      .chromosome-position
                        .chromosome 12
                        .coordinate 111767141
                    td
                      .ref-alt
                        span.ref C
                        span.arrow
                        span.alt A
                    td.separator(rowspan='2')
                    td(rowspan='2')
                      a.hyper-text.-external(target='_blank', href='https://www.ncbi.nlm.nih.gov/snp/rs567143183') rs567143183
                    td(rowspan='2') chr12:111767141
                    td C&gt;A
                    td.separator(rowspan='2')
                    td 12:g.111767141:C&gt;A
                  tr
                    td
                      a(target='_blank', href='/variant/tgv47263142') tgv47263142
                    td
                      .ref-alt
                        span.ref C
                        span.arrow
                        span.alt G
                    td C&gt;G
                    td 12:g.111767141:C&gt;G
                  tr
                    td
                      .variant-type Ins
